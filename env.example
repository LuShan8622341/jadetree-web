import { useState, FormEvent } from 'react';
import { motion } from 'motion/react';
import { Send, MapPin, Globe, Phone } from 'lucide-react';

export default function Contact() {
  const [formData, setFormData] = useState({
    name: '',
    contact: '',
    message: ''
  });
  const [status, setStatus] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (e: FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setStatus(null);

    try {
      const response = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
      });

      const data = await response.json();
      if (data.success) {
        setStatus('success');
        setFormData({ name: '', contact: '', message: '' });
      } else {
        setStatus('error');
      }
    } catch (error) {
      console.error(error);
      setStatus('error');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="bg-black min-h-screen pt-40 pb-20">
      <div className="container mx-auto px-8">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-32">
          <motion.div
            initial={{ opacity: 0, x: -30 }}
            animate={{ opacity: 1, x: 0 }}
          >
            <span className="text-brand-400 uppercase tracking-[0.5em] text-sm mb-6 block">Contact Us</span>
            <h1 className="text-6xl lg:text-9xl font-black uppercase tracking-tighter mb-12">
              建立<br />连接
            </h1>
            <p className="text-xl font-light opacity-50 mb-20 leading-relaxed max-w-md">
              无论您是寻求技术支持，还是探讨战略合作，玉树智维的全球团队随时恭候。
            </p>

            <div className="space-y-12">
              {[
                { icon: MapPin, title: "办公地点", detail: "深圳市福田区下梅林中粮·福田大悦广场39楼" },
                { icon: Phone, title: "技术支持", detail: "+86 (010) 8888-6666" },
                { icon: Globe, title: "全球网络", detail: "contact@yushu-zhiwei.com" },
              ].map((item, i) => (
                <div key={i} className="flex gap-8 group">
                  <div className="w-12 h-12 border border-white/10 rounded-full flex items-center justify-center group-hover:bg-white group-hover:text-black transition-all">
                    <item.icon size={20} />
                  </div>
                  <div>
                    <h4 className="text-xs uppercase tracking-widest font-bold opacity-30 mb-2">{item.title}</h4>
                    <p className="text-lg font-light tracking-wide">{item.detail}</p>
                  </div>
                </div>
              ))}
            </div>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, x: 30 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ delay: 0.2 }}
            className="bg-zinc-900/50 p-12 rounded-[3rem] border border-white/5"
          >
            <form className="space-y-10" onSubmit={handleSubmit}>
              <div className="space-y-4">
                <label className="text-xs uppercase tracking-widest opacity-40 font-bold ml-1">您的姓名 / Name</label>
                <input 
                  type="text" 
                  required
                  value={formData.name}
                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}
                  className="w-full bg-transparent border-b border-white/10 py-4 outline-none focus:border-brand-400 transition-all font-light text-xl"
                  placeholder="请输入姓名"
                />
              </div>

              <div className="space-y-4">
                <label className="text-xs uppercase tracking-widest opacity-40 font-bold ml-1">联系方式 / Contact</label>
                <input 
                  type="text" 
                  required
                  value={formData.contact}
                  onChange={(e) => setFormData({ ...formData, contact: e.target.value })}
                  className="w-full bg-transparent border-b border-white/10 py-4 outline-none focus:border-brand-400 transition-all font-light text-xl"
                  placeholder="微信 / 手机 / 邮箱"
                />
              </div>

              <div className="space-y-4">
                <label className="text-xs uppercase tracking-widest opacity-40 font-bold ml-1">留言内容 / Message</label>
                <textarea 
                  rows={4}
                  required
                  value={formData.message}
                  onChange={(e) => setFormData({ ...formData, message: e.target.value })}
                  className="w-full bg-transparent border-b border-white/10 py-4 outline-none focus:border-brand-400 transition-all font-light text-xl resize-none"
                  placeholder="描述您的业务需求"
                />
              </div>

              <div className="space-y-6">
                <button 
                  disabled={loading}
                  className="unitree-button unitree-button-primary w-full py-6 flex items-center justify-center gap-4 text-lg disabled:opacity-50"
                >
                  {loading ? '提交中...' : '提交申请'} <Send size={20} />
                </button>

                {status === 'success' && (
                  <p className="text-emerald-400 text-center text-sm font-medium">邮件已成功提交，我们会尽快联系您！</p>
                )}
                {status === 'error' && (
                  <p className="text-rose-400 text-center text-sm font-medium">提交失败，请检查网络或稍后重试。</p>
                )}
              </div>
            </form>
          </motion.div>
        </div>
      </div>
    </div>
  );
}

